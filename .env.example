# 服务端口（本地运行用3000，Render会自动设置）
PORT=3000

# ===== 数据库配置 =====
# DB_TYPE 决定使用哪种数据库：
#   sqlite   —— 本地开发用，数据存在 db/study.db 文件里
#   postgres —— 生产部署用，数据存在 Supabase 云端，重启/休眠不丢失
DB_TYPE=sqlite

# PostgreSQL 连接串（仅当 DB_TYPE=postgres 时需要）
# 从 Supabase 后台 → 连接 → 会话池（Session pooler）复制
# 格式：postgresql://postgres.项目标识:密码@aws-0-区域.pooler.supabase.com:5432/postgres
# DATABASE_URL=

# SQLite 数据库文件路径（仅当 DB_TYPE=sqlite 时生效，不填则用 db/study.db）
# DB_PATH=/data/study.db

# ===== 图片存储配置 =====
# STORAGE_TYPE 决定图片存在哪里：
#   local    —— 存本地磁盘（默认，本地开发用）
#   supabase —— 存 Supabase Storage 云端（生产用，重启/休眠不丢失）
STORAGE_TYPE=local

# Supabase Storage 配置（仅当 STORAGE_TYPE=supabase 时需要）
# 项目设置 → API → Project URL
# SUPABASE_URL=https://项目标识.supabase.co
# 项目设置 → API → service_role 密钥（服务端专用，切勿暴露给前端）
# SUPABASE_SERVICE_KEY=
# 存储桶名称（默认 mistake-images）
# SUPABASE_BUCKET=mistake-images

# 本地图片目录（仅当 STORAGE_TYPE=local 时生效）
# UPLOAD_DIR=/data/uploads

# 豆包大模型API配置
# 获取地址：https://console.volcengine.com/ark
DOUBAO_API_KEY=你的火山方舟API密钥
DOUBAO_MODEL=你的推理接入点ID（如ep-xxxxxxxx，DeepSeek-V4-Flash支持多模态）
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 文本向量化模型（用于RAG语义检索，需在火山方舟开通doubao-embedding）
EMBEDDING_MODEL=doubao-embedding
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings

# 视觉理解模型（用于错题图片AI识别）
# 不填则默认使用DOUBAO_MODEL（DeepSeek-V4-Flash已支持多模态视觉理解）
# VISION_MODEL=你的视觉模型接入点ID

# JWT密钥（用于用户登录认证，可自行修改）
JWT_SECRET=chuanzhibei_ai_study_assistant_secret_key_2026
