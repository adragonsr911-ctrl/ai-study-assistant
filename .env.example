# 服务端口
PORT=3000

# 豆包大模型API配置
# 获取地址：https://console.volcengine.com/ark
DOUBAO_API_KEY=你的火山方舟API密钥
DOUBAO_MODEL=你的推理接入点ID（如ep-xxxxxxxx）
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 文本向量化模型（用于RAG语义检索，需在火山方舟开通doubao-embedding）
EMBEDDING_MODEL=doubao-embedding

# 视觉理解模型（用于错题图片AI识别，需在火山方舟开通视觉模型）
# 可选：doubao-1.5-vision-pro / doubao-vision 等
VISION_MODEL=doubao-1.5-vision-pro

# JWT密钥（用于用户登录认证，可自行修改）
JWT_SECRET=chuanzhibei_ai_study_assistant_secret_key_2026
